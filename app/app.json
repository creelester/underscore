{
  "expo": {
    "name": "Under Score",
    "slug": "underscore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/dark-hero.png",
    "scheme": "underscore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/ios/light-hero.png",
        "dark": "./assets/ios/dark-hero.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/dark-hero-foreground.png",
        "backgroundImage": "./assets/android/dark-hero-background.png",
        "monochromeImage": "./assets/android/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/ios/dark-hero.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDEFE0",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#1F0F2A",
            "image": "./assets/images/splash-icon.png"
          },
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

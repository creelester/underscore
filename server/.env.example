# Template for server/.env — copy it to `.env` and fill in the blanks. This file is
# committed, so it must never carry a real value.
#
# server/src/config/env.ts loads these itself; no runner does it for us. It reads
# .env.local, then .env.${NODE_ENV}, then .env, and never overwrites a variable already
# set in the real environment — so an inline `FOO=bar bun run …` still wins over the file.
#
# NODE_ENV is deliberately absent: the `dev` script sets it inline, and a value here could
# not steer which files load anyway — config/env.ts reads NODE_ENV before it loads any.

PORT=3000

DATABASE_URL="postgresql://underscore:underscore@localhost:5432/underscore?schema=public"

# No default — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
APP_SCHEME="underscore"

# Must match the Expo origin exactly or cors() blocks every app request.
APP_ORIGIN="http://localhost:8081"

# Local development only — the seed refuses to run when NODE_ENV=production.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Real credentials — these reach live third-party APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Upstream roots. Unset means the real endpoint; override to point at a fixture server.
# GOOGLE_BOOKS_BASE_URL="https://www.googleapis.com/books/v1"
# ANTHROPIC_BASE_URL=
# SPOTIFY_ACCOUNTS_BASE_URL="https://accounts.spotify.com"
# SPOTIFY_API_BASE_URL="https://api.spotify.com/v1"

{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "e2e:db:reset": "prisma migrate reset --force --skip-generate",
    "start:e2e": "tsx src/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@underscore/shared": "workspace:*",
    "@better-auth/expo": "1.6.25",
    "@prisma/client": "5.22.0",
    "better-auth": "1.6.25",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "prisma": "5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}

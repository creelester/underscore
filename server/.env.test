# Environment for the isolated e2e stack. Safe to commit: every value here is
# test-only and unlocks nothing. The database is a throwaway localhost one and
# the auth secret is deliberately fake, so a real secret is never needed to run
# the suite.
#
# `playwright.config.ts` injects all of these through `webServer.env` and stays
# the authority: server/src/config/env.ts never overwrites a variable already in
# the process environment, so anything Playwright sets wins and this file can
# never redirect a run somewhere else. Keep the two in sync — if you change a
# port or the database here, change it there too.
#
# What this file is for is running the e2e stack by hand, outside Playwright:
#
#   bun run --filter server e2e:db:reset
#   NODE_ENV=test bun run --filter server start:e2e
#
# config/env.ts loads `.env.test` ahead of `.env` when NODE_ENV=test, so these
# override the dev values in server/.env rather than the other way round.
# Without this file that command would boot against the dev database on the dev
# port.

NODE_ENV="test"
PORT=3100

# Reset on every run by `prisma migrate reset` — never point this at `underscore`.
DATABASE_URL="postgresql://underscore:underscore@localhost:5432/underscore_e2e?schema=public"

BETTER_AUTH_SECRET="e2e-only-not-a-real-secret-0123456789"
BETTER_AUTH_URL="http://localhost:3100"
APP_SCHEME="underscore"

# Must match the Expo web origin exactly or cors() blocks every app request.
APP_ORIGIN="http://localhost:8082"

# Reseeded on every run; the specs sign in as this account.
SEED_USER_EMAIL="e2e@underscore.test"
SEED_USER_PASSWORD="e2e-password-1234"

# Social sign-in is unset — no test drives it, and it would leave localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# Google Books needs no key, so an unset key is not enough to keep a hand-run stack off
# the live API: point both upstreams at the fixture server instead
# (`bun run e2e/fixtures/upstream-server.ts`, port 3101). Playwright injects the same
# values through webServer.env, which still wins over this file.
GOOGLE_BOOKS_BASE_URL="http://localhost:3101"
ANTHROPIC_BASE_URL="http://localhost:3101"
# Non-empty only because the connector refuses to build a client without one; the
# fixture never looks at it.
ANTHROPIC_API_KEY="e2e-fixture-key-not-a-real-key"

# The same fixture server answers Spotify's token and catalogue search, so generation
# runs to completion and leaves a playlist on the shelf. Non-empty credentials only:
# the connector will not ask for a token without them.
SPOTIFY_CLIENT_ID="e2e-fixture-client-id"
SPOTIFY_CLIENT_SECRET="e2e-fixture-client-secret"
SPOTIFY_ACCOUNTS_BASE_URL="http://localhost:3101"
SPOTIFY_API_BASE_URL="http://localhost:3101"


# Empty, not absent: a key here would make every sign-up in a test run post a real
# email to Resend. Empty takes the mailer's console branch.
RESEND_API_KEY=""
EMAIL_FROM=""

{
  "name": "underscore-app",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"bun run dev:server\" \"bun run dev:ios\"",
    "dev:server": "bun run --filter server dev",
    "dev:app": "bun run --filter app start",
    "dev:ios": "bun run --filter app ios",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "20"
  },
  "overrides": {
    "better-auth": "1.6.25"
  }
}

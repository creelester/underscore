{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bun install && bun run --filter server build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production bun run --filter server start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "watchPatterns": ["server/**", "packages/shared/**", "package.json", "bun.lock"]
}
